# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAA-замените_на_свой_токен

# Ключ DeepSeek API с https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-замените_на_свой_ключ

# Необязательные настройки
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Имя бота без @ — задаётся при развороте (обязательно).
# По нему бот понимает упоминания в группах. Должно совпадать с реальным username в @BotFather.
BOT_USERNAME=sowing_tg_bot

REQUEST_TIMEOUT=180
# Уровень логов. DEBUG — логи Telegram API и входящих сообщений; в проде ERROR
LOG_LEVEL=ERROR

# Лимит длины ответов в личке/группах (0 = без ограничения)
CHAT_MAX_TOKENS=0

# Настройки inline-режима (Telegram даёт на ответ ~10 секунд)
INLINE_TIMEOUT=8.5
INLINE_MAX_TOKENS=350
INLINE_CACHE_TTL=300
WARMUP_ON_START=true

# Прогрессивный ответ в inline: показать частичный текст, не дожидаясь конца генерации
INLINE_EARLY_UPDATE=true
INLINE_EARLY_DELAY=1.2
INLINE_EARLY_MIN_CHARS=120

# Список ID пользователей, которым разрешён доступ (через запятую).
# Пусто = доступ открыт всем.
ALLOWED_USER_IDS=

# ── Bot API 10.4: HTML-виджеты (баблы сравнения) ─────────────────────────────
# База Bot API. Метод sendWidget пока на бете; после GA поставьте https://api.telegram.org
WIDGET_API_BASE=https://api.telegram.org/beta
# true = звать методы через тестовый контур (/bot<token>/test/<method>)
WIDGET_API_TEST_ENV=false

# ── Сравнение картинок /cmp ──────────────────────────────────────────────────
# Каталог SQLite-кеша сравнений (относительно корня проекта)
CMP_CACHE_DIR=var/cmp
# Сколько дней живёт сравнение (номер перестаёт работать)
CMP_CACHE_TTL_DAYS=30
# Верхняя граница числа сравнений в кеше (~10 КБ каждое)
CMP_CACHE_MAX_ENTRIES=2000
# Верхняя граница ширины картинок в бабле, px (430 = телефонный максимум).
# Это потолок: на тяжёлых фото сборщик сам опустится до ~160–180 px, чтобы влезть в 4 КБ.
CMP_TARGET_WIDTH=430
# Нижняя граница уменьшения ширины при подгонке под лимиты
CMP_MIN_WIDTH=160
# Стартовое качество WebP
CMP_START_QUALITY=34
# Нижняя граница качества при подгонке под лимиты (12 — минимум, ниже уже мыло)
CMP_MIN_QUALITY=12
# Запас в байтах под лимит zlib(level 9) = 4096
CMP_ZLIB_MARGIN=64
# Сколько байт максимум качаем по ссылке
CMP_MAX_BYTES=8388608
# Сколько секунд ждём остальные картинки альбома (Telegram шлёт их отдельными апдейтами)
CMP_ALBUM_WAIT=0.9
# Пропорции бабла: 3:2 / 4:3 / 16:9. На 3:2 на 11% меньше пикселей, чем на 4:3 —
# при том же бюджете 4 КБ это заметно чётче
CMP_ASPECT=3:2
# Длина номера сравнения в цифрах
CMP_ID_DIGITS=6
# true = номер работает у любого пользователя (по умолчанию только у автора)
CMP_SHARE_BY_ID=false
# Показывать отдельное сообщение-подсказку про inline
CMP_SHOW_HINT=true
# Разрешить ссылки на приватные/локальные адреса (SSRF-защита; оставьте false)
CMP_ALLOW_PRIVATE_HOSTS=false
# Подписи слоёв бабла: ровно две через |
CMP_LABELS=До|После
# Подпись сообщения с баблом: {id}, {a}, {b}, {bot} подставляются, перенос строки — \n.
# Только в двойных кавычках: иначе dotenv обрежет значение по «#» после пробела,
# а \n внутри кавычек станет настоящим переводом строки.
CMP_CAPTION="Номер сравнения:\n@{bot} #{id}"
# Заголовок страницы бабла и подсказка-шторка внутри него
CMP_TITLE=Сравнение
CMP_HINT=Проведите ↔
# Мини-апп для кнопки «Открыть сравнение» в inline-выдаче.
# Пусто = Main Mini App: кнопка ведёт на https://t.me/<bot>?startapp=<токен>
#         (в BotFather у бота должен быть назначен Main Mini App).
# Задано = отдельное приложение из /newapp: https://t.me/<bot>/<short>?startapp=<токен>
CMP_WEBAPP_SHORT_NAME=
# Ширина композита-превью «До|После» в пикселях
CMP_PREVIEW_WIDTH=2560
# Отдавать ли шторку (widget) в inline-выдаче @бот #номер.
# Бета Bot API отклоняет widget-контент в inline (INPUT_MEDIA_WIDGET_NOT_ALLOWED),
# поэтому по умолчанию false: остаются фото-превью, кнопка и текстовый результат.
CMP_INLINE_WIDGET=false

# ── Мини-апп сравнения /app/cmp ──────────────────────────────────────────────
# Порт HTTP-сервера мини-аппа внутри процесса бота. 0 = сервер не поднимается
# (бот работает как раньше). TLS снаружи: nginx/Caddy + proxy_pass на этот порт.
CMP_WEBAPP_PORT=0
# Интерфейс, на котором слушает сервер (в Docker — 0.0.0.0, локально — 127.0.0.1)
CMP_WEBAPP_HOST=127.0.0.1
# Публичный адрес страницы мини-аппа для логов и документации (пусто = не печатать),
# например https://example.com/app/cmp
CMP_WEBAPP_PUBLIC_URL=
# Ширина оригиналов для мини-аппа, px (WebP всегда, AVIF — если Pillow умеет)
CMP_ORIGINALS_WIDTH=1600
# Сколько секунд живёт initData мини-аппа (по умолчанию сутки)
CMP_WEBAPP_AUTH_TTL=86400
